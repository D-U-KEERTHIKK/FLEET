<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Check_Has_Products</name>
        <label>Check Has Products</label>
        <locationX>572</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Products</defaultConnectorLabel>
        <rules>
            <name>Has_Products</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OpportunityLineItems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_OpportunityLineItems</leftValueReference>
                <operator>Count</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Through_OpportunityLineItems</targetReference>
            </connector>
            <label>Has Products</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Renewal_Collection</name>
        <label>Check Renewal Collection</label>
        <locationX>572</locationX>
        <locationY>456</locationY>
        <defaultConnectorLabel>No Renewals</defaultConnectorLabel>
        <rules>
            <name>Has_Renewals</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Renewal_Collection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Renewal_Collection</leftValueReference>
                <operator>Count</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Renewal_Records</targetReference>
            </connector>
            <label>Has Renewals</label>
        </rules>
    </decisions>
    <description>Record-triggered Flow on Opportunity that fires when StageName changes to 'Closed Won'. Creates Renewal__c records for subscription products and sets Renewal_Required__c flag. Creates follow-up Task for Account Manager.</description>
    <loops>
        <name>Loop_Through_OpportunityLineItems</name>
        <label>Loop Through OpportunityLineItems</label>
        <locationX>396</locationX>
        <locationY>348</locationY>
        <collectionReference>Get_OpportunityLineItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Product_Family</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Renewal_Collection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <decisions>
        <name>Check_Product_Family</name>
        <label>Check Product Family</label>
        <locationX>220</locationX>
        <locationY>348</locationY>
        <defaultConnectorLabel>Not Subscription</defaultConnectorLabel>
        <rules>
            <name>Is_Subscription</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_OpportunityLineItems.Product2.Family</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Subscription</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_To_Renewal_Collection</targetReference>
            </connector>
            <label>Is Subscription</label>
        </rules>
    </decisions>
    <assignments>
        <name>Add_To_Renewal_Collection</name>
        <label>Add To Renewal Collection</label>
        <locationX>44</locationX>
        <locationY>348</locationY>
        <assignmentItems>
            <assignmentSequence>1</assignmentSequence>
            <leftValueReference>Renewal_Collection</leftValueReference>
            <operator>Add</operator>
            <rightValue>
                <elementReference>Create_Renewal_Record</elementReference>
            </rightValue>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_OpportunityLineItems</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Create_Renewal_Record</name>
        <label>Create Renewal Record</label>
        <locationX>44</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignmentSequence>1</assignmentSequence>
            <leftValueReference>Renewal_Record</leftValueReference>
            <operator>Assign</operator>
            <rightValue>
                <elementReference>NewRenewal</elementReference>
            </rightValue>
        </assignmentItems>
    </assignments>
    <recordCreates>
        <name>Create_Renewal_Records</name>
        <label>Create Renewal Records</label>
        <locationX>572</locationX>
        <locationY>564</locationY>
        <inputReference>Renewal_Collection</inputReference>
        <connector>
            <targetReference>Update_Opportunity_Renewal_True</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Renewal_Creation_Error</targetReference>
        </faultConnector>
    </recordCreates>
    <recordUpdates>
        <name>Update_Opportunity_Renewal_True</name>
        <label>Update Opportunity Renewal True</label>
        <locationX>572</locationX>
        <locationY>672</locationY>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>Renewal_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <connector>
            <targetReference>Create_Follow_Up_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Update_Error</targetReference>
        </faultConnector>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Opportunity_Renewal_False</name>
        <label>Update Opportunity Renewal False</label>
        <locationX>748</locationX>
        <locationY>564</locationY>
        <inputReference>$Record</inputReference>
        <inputAssignments>
            <field>Renewal_Required__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <connector>
            <targetReference>Create_Follow_Up_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handle_Update_Error</targetReference>
        </faultConnector>
    </recordUpdates>
    <recordCreates>
        <name>Create_Follow_Up_Task</name>
        <label>Create Follow Up Task</label>
        <locationX>660</locationX>
        <locationY>780</locationY>
        <description>Creates a Task for follow-up assigned to the Opportunity Owner (Account Manager)</description>
        <objectType>Task</objectType>
        <createRecordTypeSelector>false</createRecordTypeSelector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Follow-up on Closed Won Opportunity - Renewal Required</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Follow-up task for Opportunity: {!$Record.Name}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Task_Due_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <faultConnector>
            <targetReference>Handle_Task_Creation_Error</targetReference>
        </faultConnector>
    </recordCreates>
    <subflows>
        <name>Handle_Renewal_Creation_Error</name>
        <label>Handle Renewal Creation Error</label>
        <locationX>396</locationX>
        <locationY>564</locationY>
        <description>Fault handler for Renewal record creation failures</description>
    </subflows>
    <subflows>
        <name>Handle_Update_Error</name>
        <label>Handle Update Error</label>
        <locationX>748</locationX>
        <locationY>672</locationY>
        <description>Fault handler for Opportunity update failures</description>
    </subflows>
    <subflows>
        <name>Handle_Task_Creation_Error</name>
        <label>Handle Task Creation Error</label>
        <locationX>844</locationX>
        <locationY>780</locationY>
        <description>Fault handler for Task creation failures</description>
    </subflows>
    <variables>
        <name>Renewal_Collection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Renewal__c</objectType>
    </variables>
    <variables>
        <name>Renewal_Record</name>
        <dataType>SObject</dataType>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Renewal__c</objectType>
    </variables>
    <variables>
        <name>Task_Due_Date</name>
        <dataType>Date</dataType>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>$Flow.CurrentDate</elementReference>
        </value>
    </variables>
    <recordLookups>
        <name>Get_OpportunityLineItems</name>
        <label>Get OpportunityLineItems</label>
        <locationX>572</locationX>
        <locationY>132</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Has_Products</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product2Id</queriedFields>
        <queriedFields>Product2.Family</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_OpportunityLineItems</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerEvents>AFTER_CHANGE</triggerEvents>
        <triggerOnAllChanges>false</triggerOnAllChanges>
        <triggerOnCustomEvents>false</triggerOnCustomEvents>
        <triggerOptimizeContext>CHILD</triggerOptimizeContext>
        <whenStageName>
            <equalsTo>Closed Won</equalsTo>
        </whenStageName>
    </start>
    <status>Draft</status>
</Flow>