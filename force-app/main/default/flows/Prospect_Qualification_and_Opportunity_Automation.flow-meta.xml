    <decisions>
        <name>Prospect_Quality_Check</name>
        <label>Prospect Quality Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cold_Prospect_Path</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cold Prospect</defaultConnectorLabel>
        <rules>
            <name>Hot_Prospect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hot_Prospect_Path</targetReference>
            </connector>
            <label>Hot Prospect</label>
        </rules>
        <rules>
            <name>Warm_Prospect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warm_Prospect_Path</targetReference>
            </connector>
            <label>Warm Prospect</label>
        </rules>
    </decisions>
