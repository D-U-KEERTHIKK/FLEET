    <decisions>
        <name>Account_Journey_Check</name>
        <label>Account Journey Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Closed_Prospect_Path</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Closed Prospect</defaultConnectorLabel>
        <rules>
            <name>Active_Prospect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Journey__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Active_Prospect_Path</targetReference>
            </connector>
            <label>Active Prospect</label>
        </rules>
        <rules>
