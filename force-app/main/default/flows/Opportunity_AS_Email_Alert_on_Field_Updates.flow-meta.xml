    <textTemplates>
        <name>Template_AmountChange</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hello,
The amount for {!$Record.Name} was recently updated by {!GetLastModifiedName.Name}.
Old Value: {!$Record__Prior.Amount}
New Value: {!$Record.Amount}

View the Opportunity here: https://opseraio.lightning.force.com/{!$Record.Id}</text>
    </textTemplates>
    <textTemplates>
        <name>Template_CloseDatePush</name>
