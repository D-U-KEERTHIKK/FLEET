    <assignments>
        <name>Email_Alert_Recipients</name>
        <label>Email Alert Recipients</label>
        <locationX>710</locationX>
        <locationY>455</locationY>
        <assignmentItems>
            <assignToReference>varEmail_Alert_Recipients</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>clansing@opsera.io</stringValue>
            </value>
        </assignmentItems>
