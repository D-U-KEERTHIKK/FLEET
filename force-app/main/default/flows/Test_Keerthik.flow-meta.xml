    <decisions>
        <name>Account_Age_Check</name>
        <label>Account Age Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Account_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New Customer</defaultConnectorLabel>
        <rules>
            <name>Mature_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountAgeInDays</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>365.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_Opportunities</targetReference>
            </connector>
            <label>Mature Customer</label>
        </rules>
    </decisions>
    <decisions>
        <name>Account_Journey_Check</name>
        <label>Account Journey Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Other Journey</defaultConnectorLabel>
        <rules>
            <name>Journey_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Journey__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Revenue_Check</targetReference>
            </connector>
            <label>Journey Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Account_Score_Check</name>
        <label>Account Score Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Account_Journey_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>High_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Gold_Tier</targetReference>
            </connector>
            <label>High Score</label>
        </rules>
        <rules>
            <name>Medium_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>80.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Silver_Tier</targetReference>
            </connector>
            <label>Medium Score</label>
        </rules>
        <rules>
            <name>Low_Score</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Bronze_Tier</targetReference>
            </connector>
            <label>Low Score</label>
        </rules>
    </decisions>
    <decisions>
        <name>Assign_Customer_Success_Team</name>
        <label>Assign Customer Success Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_SBM_Team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SMB Team</defaultConnectorLabel>
        <rules>
            <name>Enterprise_Team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enterprise</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Enterprise_Team</targetReference>
            </connector>
            <label>Enterprise Team</label>
        </rules>
        <rules>
            <name>Growth_Team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mid Market</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Growth_Team</targetReference>
            </connector>
            <label>Growth Team</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Open_Opportunities</name>
        <label>Has Open Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Customer_Success_Team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Open Opportunities</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Opportunities</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Customer_Success_Team</targetReference>
            </connector>
            <label>Opportunity Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Revenue_Check</name>
        <label>Revenue Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_SMB_Segment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>SMB Customer</defaultConnectorLabel>
        <rules>
            <name>Enterprise_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AnnualRevenue</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1000000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Enterprise_Segment</targetReference>
            </connector>
            <label>Enterprise Customer</label>
        </rules>
        <rules>
            <name>Mid_Market_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AnnualRevenue</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>100000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Mid_Market_Segment</targetReference>
            </connector>
            <label>Mid Market Customer</label>
        </rules>
    </decisions>
    <decisions>
        <name>Strategic_Customer_Check</name>
        <label>Strategic Customer Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Else</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard Customer</defaultConnectorLabel>
        <rules>
            <name>Strategic_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Segment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enterprise</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.account_score__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>90.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment_8</targetReference>
            </connector>
            <label>Strategic Customer</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AccountAgeInDays</name>
        <dataType>Number</dataType>
        <expression>TODAY() - DATEVALUE($Record.CreatedDate)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>GeneratedAccountNumberFormula</name>
        <dataType>String</dataType>
        <expression>&quot;CUST-&quot; &amp; RIGHT($Record.Id,5)</expression>
    </formulas>
    <interviewLabel>Test_Keerthik {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Customer Status Processing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account_Opportunities</name>
        <label>Get Account Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Open_Opportunities</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Generate_Account_Number</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Custom_Account_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
