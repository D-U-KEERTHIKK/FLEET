<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Urgent_Requires_Description</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Priority__c, &quot;Urgent&quot;),
    ISBLANK(Issue_Description__c)
)</errorConditionFormula>
    <errorMessage>Urgent requests require an issue description.</errorMessage>
</ValidationRule>
